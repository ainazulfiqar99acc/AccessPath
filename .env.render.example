# Reference only. Enter secrets directly in Render; never commit a populated copy.
# RENDER_EXTERNAL_URL is supplied by Render. For a custom domain set FRONTEND_ORIGIN.
ACCESSPATH_MODE=hosted
SYNTHETIC_DEMO=true
AI_PROVIDER=groq
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_API_KEY=
AI_TIMEOUT_SECONDS=120
DEMO_TTL_SECONDS=7200
ACCESSPATH_DATA=/tmp/accesspath
PORTAL_URL=http://127.0.0.1:9314
# PORT is supplied by Render; startup defaults to 10000.
